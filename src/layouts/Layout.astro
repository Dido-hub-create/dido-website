---
import "@fontsource-variable/manrope";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title,
  description = "Личният свят на DIDO — бягане, технологии, полезни идеи и нови хоризонти.",
  image,
} = Astro.props;
const pageTitle = title
  ? `${title} — DIDO`
  : "DIDO — В движение. С любопитство.";
const navigation = [
  ["/", "Начало"],
  ["/byagane/", "Бягане"],
  ["/tehnologii/", "Технологии"],
  ["/polezno/", "Полезно"],
  ["/za-men/", "За мен"],
  ["/finansi/", "Финанси"],
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101827" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bg_BG" />
    {
      image?.startsWith("https://") && (
        <meta property="og:image" content={image} />
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Към съдържанието</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="DIDO — Начало"
          >DIDO<span>.</span></a
        >
        <span class="brand-caption">ЛИЧНО ПРОСТРАНСТВО</span>
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="main-navigation"
          ><span class="menu-label">Меню</span><span
            class="menu-lines"
            aria-hidden="true"></span></button
        >
        <nav
          id="main-navigation"
          class="navigation"
          aria-label="Главна навигация"
        >
          {
            navigation.map(([href, label]) => (
              <a
                href={href}
                class:list={{
                  active:
                    current === href ||
                    (href !== "/" && current.startsWith(href)),
                }}
                aria-current={current === href ? "page" : undefined}
              >
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div>
          <a class="brand" href="/">DIDO<span>.</span></a><p>
            В движение. С любопитство.
          </p>
        </div><a href="/za-men/" class="text-link"
          >Още за мен <Icon name="diagonal" size={18} /></a>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getUTCFullYear()} DIDO. Лично пространство.</span
        ><span>Бягане · Технологии · Нови идеи</span><a href="#main"
          >Към началото ↑</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>(".navigation");
      function closeMenu() {
        toggle?.setAttribute("aria-expanded", "false");
        nav?.classList.remove("is-open");
      }
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        nav?.classList.toggle("is-open", open);
      });
      nav
        ?.querySelectorAll("a")
        .forEach((link) => link.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeMenu();
          if (nav?.contains(document.activeElement)) toggle?.focus();
        }
      });
      document.addEventListener("click", (event) => {
        if (
          event.target instanceof Node &&
          !nav?.contains(event.target) &&
          !toggle?.contains(event.target)
        )
          closeMenu();
      });
      matchMedia("(min-width: 961px)").addEventListener("change", closeMenu);
      document
        .querySelectorAll<HTMLImageElement>(".prose img")
        .forEach((img) => {
          img.loading = "lazy";
          if (img.src.includes("/public/images/"))
            img.src = img.src.replace("/public/images/", "/images/");
          function fallback() {
            const note = document.createElement("span");
            note.className = "image-unavailable";
            note.textContent = img.alt || "Изображението не е налично.";
            img.replaceWith(note);
          }
          img.addEventListener("error", fallback, { once: true });
          if (img.complete && img.naturalWidth === 0) fallback();
        });
    </script>
  </body>
</html>
