---
import RaceResult from './RaceResult.astro';
import {formatRaceDate} from '../lib/races.mjs';
interface Props {race:any}
const {race}=Astro.props;
---
<article class="race-card archived-race-card" id={`race-${race.id}`} data-race={JSON.stringify({date:race.date,startTime:race.startTime,timeZone:race.timeZone,status:race.status})}>
 <header><h3><a href={race.href}>{race.title}</a></h3><p class="archived-meta">{formatRaceDate(race)}{race.distance && <> · {race.distance}</>}{race.location && <span>{race.location}</span>}</p></header>
 <RaceResult race={race}/>
 <a class="archive-story" href={race.href}>Снимки, маршрут и история <span aria-hidden="true">→</span></a>
</article>
<style>
.archived-race-card{display:flex!important;flex-direction:column!important;gap:6px;padding:16px!important;border:1px solid #344a67;border-radius:16px;background:linear-gradient(140deg,#15273d,#101d30);box-shadow:0 5px 18px #0002;min-width:0}.archived-race-card h3{font-size:1.05rem!important;line-height:1.3;margin:0!important;overflow-wrap:anywhere}.archived-meta{font-size:12px!important;line-height:1.5!important;color:#b7c5d8;margin:5px 0 0!important}.archived-meta span{display:block}.archive-story{font-size:12px;color:#c2d4e9;margin-top:auto;padding-top:5px}.archive-story:focus-visible{outline:2px solid #ff8a16;outline-offset:4px}@media(max-width:400px){.archived-race-card{padding:14px!important}}
</style>
