---
import { projects } from "../lib/content-utils.mjs";
import AppGallery from "./AppGallery.astro";
import Icon from "./Icon.astro";
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

{!compact ? <AppGallery /> : <section
  class:list={["section projects-section", { "projects-compact": compact }]}
  id="moite-prilozheniya"
  aria-labelledby="projects-title"
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">СЪЗДАДЕНО С ЛЮБОПИТСТВО</p><h2 id="projects-title">
        Моите приложения<span>.</span>
      </h2>
    </div><span class="section-note">Малки идеи. Практични решения.</span>
  </div>
  <div class="projects-grid">
    {
      projects.map((project, index) => (
        <article class="project-card">
          <>
            <div class="project-top">
              <>
                <Icon name={project.icon} size={29} />
                <span class="project-number">0{index + 1}</span>
              </>
            </div>
            <span class="status">
              <span />
              Планирано
            </span>
            <h3>{project.title}</h3>
            <p>{project.text}</p>
          </>
        </article>
      ))
    }
  </div>
  <p class="projects-note">
    Идеи в развитие — ще споделя повече, когато са готови.
  </p>
</section>}
