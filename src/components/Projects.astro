---
import {applicationCategories} from '../lib/applications.mjs';
interface Props {compact?:boolean}
const categories=applicationCategories();
---
<section class="section compact-applications" aria-labelledby="home-apps-title">
 <div class="section-heading"><h2 id="home-apps-title">Моите приложения<span>.</span></h2><a class="text-link" href="/prilozheniya/">Виж всички приложения →</a></div>
 <ul>{categories.map(c=><li>{c.apps.length?<a href={c.href}>{c.title}</a>:<span>{c.title}</span>}</li>)}</ul>
</section>
<style>.compact-applications ul{display:flex;flex-wrap:wrap;gap:10px;padding:0;list-style:none}.compact-applications li{border:1px solid var(--line);border-radius:10px;background:#142236}.compact-applications li a,.compact-applications li span{display:block;padding:12px 16px;line-height:1.4;color:inherit}.compact-applications li a:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.compact-applications .section-heading{flex-wrap:wrap;gap:12px}@media(max-width:600px){.compact-applications .section-heading{display:block}.compact-applications .text-link{display:inline-block;margin-block:12px}.compact-applications li{font-size:.85rem}}</style>
