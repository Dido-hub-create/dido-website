---
import Cabinet from './Cabinet.astro';
const planned = [
 {title:'Дигитални дъски', image:'01_digitalni_daski.png', description:'Интерактивни дъски по математика, графики и визуални задачи.', status:'В разработка'},
 {title:'Финансов калкулатор', image:'02_finansov_kalkulator.png', description:'Полезни изчисления, бюджет и лични финанси.', status:'Планирано'},
 {title:'Личен органайзер', image:'03_lichen_organizer.png', description:'Задачи, планове и организация на ежедневието.', status:'Планирано'},
];
---
<section class="section app-gallery" id="moite-prilozheniya" aria-labelledby="projects-title">
 <div class="section-heading"><div><p class="eyebrow">СЪЗДАДЕНО С ЛЮБОПИТСТВО</p><h2 id="projects-title">Моите приложения<span>.</span></h2></div><span class="section-note">Идеи, инструменти и експерименти.</span></div>
 <div class="app-grid">
 {planned.map(app=><article class="app-card"><div class="app-art"><img src={'/images/apps/'+app.image} alt="" width="477" height="255" loading="lazy" /></div><div class="app-copy"><span class:list={['app-status',{'in-development':app.status==='В разработка'}]}>{app.status}</span><h3>{app.title}</h3><p>{app.description}</p></div></article>)}
 <Cabinet />
 <article class="app-card"><div class="app-art"><img src="/images/apps/05_fitness_trakeri.png" alt="" width="736" height="245" loading="lazy" /></div><div class="app-copy"><span class="app-status">Планирано</span><h3>Фитнес тракери</h3><p>Бъдеща колекция от HTML приложения за тренировки, активност и форма, създадени с различни AI инструменти.</p></div></article>
 </div>
</section>
<style is:global>
.app-gallery .app-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:20px;align-items:stretch}.app-gallery .app-card{grid-column:span 2;min-width:0;overflow:hidden;display:flex;flex-direction:column;border:1px solid #334b70;border-radius:18px;background:linear-gradient(145deg,#13263d,#101b2e);box-shadow:0 8px 24px #0002;transition:transform .24s ease,box-shadow .24s ease,border-color .24s ease}.app-gallery .app-card:nth-child(n+4){grid-column:span 3}.app-gallery .app-art{overflow:hidden;height:170px;background:#102440;flex-shrink:0}.app-gallery .app-art img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .4s ease}.app-gallery .app-copy{padding:20px;display:flex;flex-direction:column;align-items:flex-start;gap:12px;flex:1}.app-gallery h3{font-size:1.2rem;line-height:1.3;margin:0;color:#f5f8ff}.app-gallery .app-copy>p{margin:0;color:#b7c5d8;font-size:.93rem;line-height:1.65}.app-gallery .app-status{font-size:.75rem;font-weight:700;letter-spacing:.02em;padding:5px 10px;border:1px solid #5b5287;background:#51407833;color:#d7ceff;border-radius:100px}.app-gallery .in-development{color:#ffcf79;border-color:#98763f;background:#67451a33}.app-gallery .is-available{color:#9fe4d4;border-color:#35796c;background:#15514533}.app-gallery .app-card:focus-within{border-color:#63b9ef;box-shadow:0 12px 28px #0004,0 0 22px #139eff18}.app-gallery .app-card a:focus-visible{outline:3px solid #ffab4c;outline-offset:4px}@media(hover:hover){.app-gallery .app-card:hover{transform:translateY(-4px);border-color:#508fbd;box-shadow:0 14px 32px #0005,0 0 24px #139eff1a}.app-gallery .app-card:hover .app-art img{transform:scale(1.025) translateY(-1px)}}@media(max-width:900px){.app-gallery .app-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.app-gallery .app-card,.app-gallery .app-card:nth-child(n+4){grid-column:auto}.app-gallery .app-card:last-child{grid-column:1/-1}}@media(max-width:560px){.app-gallery .section-heading{display:block}.app-gallery .section-note{display:block;margin-top:12px;text-align:left;max-width:none}.app-gallery .app-grid{grid-template-columns:minmax(0,1fr);gap:16px}.app-gallery .app-card:last-child{grid-column:auto}.app-gallery .app-art{height:155px}.app-gallery .app-copy{padding:18px}}@media(prefers-reduced-motion:reduce){.app-gallery .app-card,.app-gallery .app-art img{transition:none}.app-gallery .app-card:hover,.app-gallery .app-card:hover .app-art img{transform:none}}
</style>
