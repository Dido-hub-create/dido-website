---
import {applicationCategories} from '../lib/applications.mjs';
const categories=applicationCategories();
---
<section class="section app-gallery" id="moite-prilozheniya" aria-label="Категории приложения">
 <div class="app-grid">
 {categories.map(category=>{const Tag=category.apps.length?'a':'article';return <Tag class:list={['app-card',{'is-active':category.apps.length>0}]} href={category.apps.length?category.href:undefined}>
 <div class="app-art"><img src={category.image} alt="" width="736" height="245" loading="lazy" style={category.slug==='digitalni-kabineti'?'object-fit:contain':undefined}/></div>
 <div class="app-copy"><h2>{category.title}</h2><p>{category.description}</p></div>
 </Tag>})}
 </div>
</section>
<style is:global>
.app-gallery .app-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:20px;align-items:stretch}.app-gallery .app-card{color:inherit;text-decoration:none;grid-column:span 2;min-width:0;overflow:hidden;display:flex;flex-direction:column;border:1px solid #334b70;border-radius:18px;background:linear-gradient(145deg,#13263d,#101b2e);box-shadow:0 8px 24px #0002;transition:transform .24s ease,box-shadow .24s ease,border-color .24s ease}.app-gallery .app-card:nth-child(n+4){grid-column:span 3}.app-gallery .app-art{overflow:hidden;height:170px;background:#102440;flex-shrink:0}.app-gallery .app-art img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .4s ease}.app-gallery .app-copy{padding:20px;display:flex;flex-direction:column;align-items:flex-start;gap:12px;flex:1}.app-gallery h2{font-size:1.2rem;line-height:1.3;margin:0;color:#f5f8ff}.app-gallery .app-copy>p{margin:0;color:#b7c5d8;font-size:.93rem;line-height:1.65}.app-gallery .app-card.is-active:focus-visible{border-color:#63b9ef;box-shadow:0 12px 28px #0004,0 0 22px #139eff18}.app-gallery .app-card.is-active:focus-visible{outline:3px solid #ffab4c;outline-offset:4px}@media(hover:hover){.app-gallery .app-card.is-active:hover{transform:translateY(-4px);border-color:#508fbd;box-shadow:0 14px 32px #0005,0 0 24px #139eff1a}.app-gallery .app-card.is-active:hover .app-art img{transform:scale(1.025) translateY(-1px)}}@media(max-width:900px){.app-gallery .app-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.app-gallery .app-card,.app-gallery .app-card:nth-child(n+4){grid-column:auto}.app-gallery .app-card:last-child{grid-column:1/-1}}@media(max-width:560px){.app-gallery .section-heading{display:block}.app-gallery .section-note{display:block;margin-top:12px;text-align:left;max-width:none}.app-gallery .app-grid{grid-template-columns:minmax(0,1fr);gap:16px}.app-gallery .app-card:last-child{grid-column:auto}.app-gallery .app-art{height:155px}.app-gallery .app-copy{padding:18px}}@media(prefers-reduced-motion:reduce){.app-gallery .app-card,.app-gallery .app-art img{transition:none}.app-gallery .app-card.is-active:hover,.app-gallery .app-card.is-active:hover .app-art img{transform:none}}
</style>
