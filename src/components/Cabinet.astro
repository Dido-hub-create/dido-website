---
import data from '../data/cabinet.json';
const image = typeof data.image === 'string' && /^\/images\/[\p{L}\p{N} _./%-]+$/u.test(data.image) && !data.image.includes('..') ? data.image : '';
---
<section class="section cabinet" aria-labelledby="cabinet-title">
  <p class="eyebrow">ПРАКТИЧЕН ИНСТРУМЕНТ</p>
  <h2 id="cabinet-title">{data.title}</h2>
  <p>{data.description}</p>
  {image && <img class="cabinet-image" src={image} alt="Дигитален кабинет за учителя" loading="lazy" />}
  <div class="cabinet-actions">
    <a class="cabinet-action online" href="/tehnologii/digitalen-kabinet/">
      <svg viewBox="0 0 48 48" aria-hidden="true"><rect x="5" y="6" width="38" height="28" rx="4"/><path d="M24 34v8m-10 0h20"/><path class="boot" d="m18 16 12 8-12 6z"/></svg>
      <strong>Работи онлайн <span aria-hidden="true">↗</span></strong><span>Отвори кабинета директно в този браузър.</span>
    </a>
    <a class="cabinet-action download" href="/downloads/digitalen-kabinet.html" download="digitalen-kabinet.html">
      <svg viewBox="0 0 48 48" aria-hidden="true"><g class="arrow"><path d="M24 5v25m-9-9 9 9 9-9"/></g><path d="M7 31v11h34V31"/></svg>
      <strong>Изтегли за компютър <span aria-hidden="true">↓</span></strong><span>Един HTML файл — без инсталация.</span>
    </a>
  </div>
  <p class="cabinet-note">Пазят се имена, описания и връзки; самите документи не се качват в DIDO. Данните остават в браузъра ви. Онлайн и локалната версия имат отделно хранилище — използвайте Експорт и Импорт за прехвърляне.</p>
</section>
<style>
.cabinet>p{max-width:850px}.cabinet-image{max-width:100%;height:auto;border-radius:18px;margin-block:20px}.cabinet-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-block:26px}.cabinet-action{display:flex;flex-direction:column;gap:14px;padding:28px;border:1px solid var(--line);border-radius:18px;background:var(--surface,#142133);color:inherit;text-decoration:none;transition:transform .22s,box-shadow .22s,border-color .22s}.cabinet-action strong{font-size:1.15rem}.cabinet-action>span,.cabinet-note{color:var(--muted,#aab8cb);line-height:1.7}.cabinet-action svg{width:48px;height:48px;fill:none;stroke:#ff8a16;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}.cabinet-action:hover,.cabinet-action:focus-visible{transform:translateY(-4px);border-color:#ff8a16;box-shadow:0 12px 32px #0005,0 0 24px #ff8a1615}.cabinet-action:active{transform:translateY(-1px) scale(.99)}.online:hover .boot,.online:focus-visible .boot{animation:boot .65s ease both}.download:hover .arrow,.download:focus-visible .arrow{animation:download .65s ease both}@keyframes boot{from{opacity:.2;transform:scale(.85);transform-origin:center}to{opacity:1;transform:scale(1)}}@keyframes download{50%{transform:translateY(5px)}}@media(max-width:600px){.cabinet-actions{grid-template-columns:1fr}.cabinet-action{padding:22px}}@media(prefers-reduced-motion:reduce){.cabinet-action{transition:none}.cabinet-action:hover,.cabinet-action:focus-visible,.cabinet-action:active{transform:none}.cabinet-action svg *{animation:none!important}}
</style>
