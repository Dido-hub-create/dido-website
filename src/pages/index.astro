---
import Layout from "../layouts/Layout.astro";
import FramedImage from "../components/FramedImage.astro";
import Icon from "../components/Icon.astro";
import Records from "../components/Records.astro";
import Projects from "../components/Projects.astro";
import PostCard from "../components/PostCard.astro";
import { allPosts, usableImage } from "../lib/posts";
import { categories } from "../lib/content-utils.mjs";
import { site, siteIdentity } from "../lib/site.mjs";
import { homeContent } from "../lib/home.mjs";
import { loadRaces } from "../lib/running.mjs";
import { formatRaceDate } from "../lib/races.mjs";
const posts = await allPosts();
const home = homeContent(site, posts, loadRaces());
const latestFinance = posts.find((post) => post.category.slug === "finansi");
const heroImage = usableImage(home.heroImage);
const financeImage = usableImage(site.financeImage);
const aboutImage = usableImage(site.aboutImage);
const homeCategories = categories.filter((category) =>
  ["byagane", "tehnologii", "polezno"].includes(category.slug),
);
---

<Layout title={home.title} description={home.intro} image={heroImage}>
  <div class="homepage">
    <section class="welcome-hero" aria-labelledby="welcome-title">
      {
        heroImage && (
          <FramedImage
            class="welcome-scene"
            src={heroImage}
            alt=""
            frame={home.heroFrame}
            loading="eager"
            width={2001}
            height={786}
            fetchpriority="high"
          />
        )
      }
      <div class="container welcome-content">
        <h1 id="welcome-title">{home.title}</h1>
        <svg class="welcome-stroke" viewBox="0 0 110 13" aria-hidden="true"
          ><path d="M3 10Q49-4 106 8 50 3 3 12Z" fill="currentColor"
          ></path></svg
        >
        <p>{home.intro}</p>
        <div class="welcome-actions">
          <a class="button" href="#posledni-publikacii"
            >Разгледай статиите <Icon name="arrow" size={22} /></a
          ><a class="button button-secondary" href="/za-men/">За мен</a>
        </div>
      </div>
    </section>
    <div class="container magazine-body">
      <Records />
      {home.race && <aside class="home-race-accent" aria-label="Състезание на фокус">
        <p class="eyebrow">На фокус</p><h2><a href={home.race.href}>{home.race.title}</a></h2>
        {home.raceCaption && <p>{home.raceCaption}</p>}
        <p>{formatRaceDate(home.race)}</p><a class="text-link" href={home.race.href}>Към състезанието →</a>
      </aside>}
      {(home.featured || home.selected.length > 0) && <section class="home-spotlight" aria-labelledby="home-featured-title">
        <div class="section-heading"><h2 id="home-featured-title">Избрани истории<span>.</span></h2></div>
        {home.featured && <PostCard post={home.featured} />}
        {home.selected.length > 0 && <div class="home-selected-grid">{home.selected.map((post) => <PostCard post={post} />)}</div>}
      </section>}
      <section
        class="home-columns"
        id="posledni-publikacii"
        aria-label="Последни статии по раздели"
      >
        {
          homeCategories.map((category) => {
            const categoryPosts = home.remainingPosts
              .filter((post) => post.category.slug === category.slug)
              .slice(0, 2);
            return (
              <section
                class="home-category"
                aria-labelledby={`home-${category.slug}`}
              >
                <div class="home-category-heading">
                  <>
                    <h2 id={`home-${category.slug}`}>
                      <Icon name={category.icon} size={31} />
                      {category.label}
                    </h2>
                    <a class="text-link" href={`/${category.slug}/`}>
                      Виж всички{" "}
                      <>
                        <Icon name="arrow" size={19} />
                        <span class="sr-only"> в {category.label}</span>
                      </>
                    </a>
                  </>
                </div>
                {categoryPosts.length ? (
                  <div class="home-category-posts">
                    {categoryPosts.map((post) => (
                      <PostCard post={post} />
                    ))}
                  </div>
                ) : (
                  <div class="home-category-empty">
                    <Icon name={category.icon} size={35} />
                    <h3>
                      {category.slug === "byagane"
                        ? "Историите от маршрута предстоят."
                        : "От идея до нещо полезно."}
                    </h3>
                    <p>
                      {category.slug === "byagane"
                        ? home.runningDescription
                        : home.technologyDescription}
                    </p>
                    <a
                      class="text-link"
                      href={
                        category.slug === "byagane"
                          ? "/byagane/#lichni-rekordi"
                          : "/tehnologii/#moite-prilozheniya"
                      }
                    >
                      {category.slug === "byagane"
                        ? "Личните ми рекорди"
                        : "Моите приложения"}{" "}
                      <Icon name="arrow" size={18} />
                    </a>
                  </div>
                )}
              </section>
            );
          })
        }
      </section>
      <section class="home-features" aria-label={`Още от ${siteIdentity().name}`}>
        <article class="home-feature finance-feature">
          <a
            class="feature-picture"
            href="/finansi/"
            tabindex="-1"
            aria-hidden="true"
            >{
              financeImage ? (
                <FramedImage
                  src={financeImage}
                  alt=""
                  frame={site.financeFrame}
                  width={520}
                  height={340}
                  loading="lazy"
                />
              ) : (
                <span class="feature-fallback" aria-hidden="true">
                  ₿
                </span>
              )
            }</a
          >
          <div>
            <h2><Icon name="bitcoin" size={29} />Финанси / Bitcoin</h2><p>
              {
                latestFinance ? (
                  <a href={latestFinance.href}>{latestFinance.data.title}</a>
                ) : (
                  <>
                    {home.financeDescription}
                  </>
                )
              }
            </p><a class="button button-outline" href="/finansi/"
              >Към секцията <Icon name="arrow" size={20} /></a
            >
          </div>
        </article>
        <article class="home-feature about-feature">
          <a
            class="feature-picture"
            href="/za-men/"
            tabindex="-1"
            aria-hidden="true"
            >{
              aboutImage ? (
                <FramedImage
                  src={aboutImage}
                  alt=""
                  frame={site.aboutFrame}
                  width={520}
                  height={340}
                  loading="lazy"
                />
              ) : (
                <span class="feature-fallback">
                  <Icon name="user" size={65} />
                </span>
              )
            }</a
          >
          <div>
            <h2><Icon name="user" size={29} />За мен</h2><p>
              {home.aboutDescription}
            </p><a class="button button-outline" href="/za-men/"
              >Научи повече <Icon name="arrow" size={20} /></a
            >
          </div>
        </article>
      </section>
      <Projects compact />
    </div>
  </div>
</Layout>
