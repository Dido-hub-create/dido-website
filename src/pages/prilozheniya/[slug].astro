---
import Layout from '../../layouts/Layout.astro';
import Application from '../../components/Cabinet.astro';
import {applicationCategories} from '../../lib/applications.mjs';
export function getStaticPaths(){return applicationCategories().map(category=>({params:{slug:category.slug},props:{category}}));}
const {category}=Astro.props;
---
<Layout title={category.title} description={category.description}><div class="container category-page"><div class="breadcrumbs"><a href="/prilozheniya/">Моите приложения</a><span>/</span><span>{category.title}</span></div><section class="page-intro"><div><h1>{category.title}<span>.</span></h1><p>{category.description}</p></div></section>{category.apps.length?category.apps.map(app=><Application app={app}/>):<div class="empty-state"><h2>Все още няма публикувани приложения в тази категория.</h2><p>Разгледайте останалите категории.</p></div>}<a class="text-link" href="/prilozheniya/">← Всички приложения</a></div></Layout>
