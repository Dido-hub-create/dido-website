---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { allPosts, formatDate, usableImage } from "../../lib/posts";
export async function getStaticPaths() {
  return (await allPosts()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const gallery = (post.data.gallery ?? [])
  .map(usableImage)
  .filter((image): image is string => Boolean(image));
---

<Layout title={post.data.title} description={post.summary} image={post.cover}>
  <article class="container article-page">
    <div class="breadcrumbs">
      <a href="/">Начало</a><span>/</span><a href={`/${post.category.slug}/`}
        >{post.category.label}</a
      ><span>/</span><span>Публикация</span>
    </div>
    <header class="article-header">
      <a class="eyebrow" href={`/${post.category.slug}/`}
        >{post.category.label}</a
      ><h1>{post.data.title}</h1><div class="post-meta">
        <span>DIDO · ЛИЧЕН ДНЕВНИК</span>{
          post.data.date && (
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          )
        }{post.data.topic && <span>{post.data.topic}</span>}
      </div>{
        post.data.description && (
          <p class="article-description">{post.data.description}</p>
        )
      }
    </header>
    {
      post.cover && (
        <figure class="article-cover">
          <img
            src={post.cover}
            alt={`Основна снимка: ${post.data.title}`}
            width="1200"
            height="1600"
            fetchpriority="high"
          />
        </figure>
      )
    }
    <div class="prose"><Content /></div>
    {
      gallery.length > 0 && (
        <section class="article-gallery" aria-labelledby="gallery-title">
          <>
            <div class="section-heading">
              <>
                <div>
                  <>
                    <p class="eyebrow">В КАДЪР</p>
                    <h2 id="gallery-title">
                      Галерия<span>.</span>
                    </h2>
                  </>
                </div>
                <span class="section-note">
                  Натисни снимка, за да я разгледаш.
                </span>
              </>
            </div>
            <div class="gallery-grid">
              {gallery.map((image, index) => (
                <a
                  class="gallery-item"
                  href={image}
                  data-gallery-image
                  aria-label={`Отвори снимка ${index + 1} от галерията`}
                >
                  <img
                    src={image}
                    alt={`Снимка ${index + 1} от галерията към „${post.data.title}“`}
                    loading="lazy"
                    width="600"
                    height="800"
                  />
                  <span>
                    <Icon name="diagonal" size={21} />
                  </span>
                </a>
              ))}
            </div>
          </>
        </section>
      )
    }
    <div class="article-back">
      <a class="text-link" href={`/${post.category.slug}/`}
        >← Обратно към {post.category.label}</a>
    </div>
  </article>
  {
    gallery.length > 0 && (
      <dialog class="lightbox" aria-label="Преглед на снимка">
        <>
          <button
            class="lightbox-close"
            type="button"
            aria-label="Затвори снимката"
          >
            Затвори ×
          </button>
          <img src={gallery[0]} alt="" />
          <p class="lightbox-caption" />
        </>
      </dialog>
    )
  }
  <script>
    const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
    document
      .querySelectorAll<HTMLAnchorElement>("[data-gallery-image]")
      .forEach((link) =>
        link.addEventListener("click", (event) => {
          if (
            !dialog ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          )
            return;
          event.preventDefault();
          const image = dialog.querySelector("img");
          const thumb = link.querySelector("img");
          if (image) {
            image.src = link.href;
            image.alt = thumb?.alt ?? "";
          }
          const caption = dialog.querySelector(".lightbox-caption");
          if (caption) caption.textContent = thumb?.alt ?? "";
          dialog.showModal();
        }),
      );
    dialog
      ?.querySelector("button")
      ?.addEventListener("click", () => dialog.close());
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  </script>
</Layout>
