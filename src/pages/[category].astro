---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Records from "../components/Records.astro";
import RunningDashboard from "../components/RunningDashboard.astro";
import Projects from "../components/Projects.astro";
import PostCard from "../components/PostCard.astro";
import { categories } from "../lib/content-utils.mjs";
import { allPosts } from "../lib/posts";
export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}
const { category } = Astro.props;
const posts = (await allPosts()).filter(
  (post) => post.category.slug === category.slug,
);
---

<Layout title={category.label} description={category.description}>
  <div class="container category-page">
    <div class="breadcrumbs">
      <a href="/">Начало</a><span>/</span><span>{category.label}</span>
    </div>
    <section class="page-intro">
      <div>
        <p class="eyebrow">{category.eyebrow}</p><h1>
          {category.label}<span>.</span>
        </h1><p>{category.description}</p>
      </div><div class="category-emblem">
        <Icon name={category.icon} size={72} />
      </div>
    </section>
    {
      category.slug === "byagane" && (
        <>
          <>
            <Records />
            <RunningDashboard />
          </>
        </>
      )
    }
    {category.slug === "tehnologii" && <Projects />}
    <section class="section" aria-labelledby="category-posts-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">ЛИЧНИЯТ ДНЕВНИК</p><h2 id="category-posts-title">
            Публикации<span>.</span>
          </h2>
        </div><span class="section-note"
          >{posts.length}
          {posts.length === 1 ? "публикация" : "публикации"}</span
        >
      </div>
      <div class="topic-filters" role="group" aria-label="Филтриране по тема">
        <button
          class="topic-filter is-active"
          type="button"
          data-topic="all"
          aria-pressed="true">Всички</button
        >{
          category.topics.map((topic) => (
            <button
              class="topic-filter"
              type="button"
              data-topic={topic}
              aria-pressed="false"
            >
              {topic}
            </button>
          ))
        }
      </div>
      <div class="category-posts">
        {
          posts.map((post) => (
            <div
              class="filterable-post"
              data-post-topic={post.data.topic ?? ""}
            >
              <PostCard post={post} />
            </div>
          ))
        }
      </div>
      <div class="empty-state" id="category-empty" hidden={posts.length > 0}>
        <Icon name={category.icon} size={36} /><h3>
          Следващата история предстои.
        </h3><p>Тук ще се появят публикациите по тази тема.</p><a
          class="text-link"
          href="/"
          >Разгледай началната страница <Icon name="arrow" size={18} /></a
        >
      </div>
    </section>
  </div>
  <script>
    const filters =
      document.querySelectorAll<HTMLButtonElement>(".topic-filter");
    const posts = document.querySelectorAll<HTMLElement>(".filterable-post");
    const empty = document.querySelector<HTMLElement>("#category-empty");
    filters.forEach((button) =>
      button.addEventListener("click", () => {
        filters.forEach((filter) => {
          const active = filter === button;
          filter.classList.toggle("is-active", active);
          filter.setAttribute("aria-pressed", String(active));
        });
        let visible = 0;
        posts.forEach((post) => {
          post.hidden =
            button.dataset.topic !== "all" &&
            post.dataset.postTopic !== button.dataset.topic;
          if (!post.hidden) visible++;
        });
        if (empty) empty.hidden = visible > 0;
        if (button.dataset.topic === "Моите приложения")
          document.querySelector("#moite-prilozheniya")?.scrollIntoView({
            behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
              ? "instant"
              : "smooth",
          });
        if (button.dataset.topic === "Лични рекорди")
          document.querySelector("#lichni-rekordi")?.scrollIntoView({
            behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
              ? "instant"
              : "smooth",
          });
      }),
    );
  </script>
</Layout>
