{
  "name": "DIDO — преглед в браузъра",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "remoteUser": "node",
  "remoteEnv": { "ASTRO_TELEMETRY_DISABLED": "1" },
  "postCreateCommand": "npm ci",
  "postStartCommand": "npm run dev -- --port 4321 --background",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": { "label": "DIDO — частен преглед", "onAutoForward": "openBrowser" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" }
}
